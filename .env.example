# === 前端（Vite 环境变量，VITE_ 前缀） ===
VITE_OPENCLAW_WS_URL=ws://127.0.0.1:18789
VITE_OPENCLAW_TOKEN=
VITE_ADMIN_USER_IDS=
VITE_APP_NAME=AI 助手
VITE_APP_SUBTITLE=
VITE_STORAGE_PREFIX=app

# === 后端（Express 服务器） ===
JWT_SECRET=          # 生产必填！用 openssl rand -hex 32 生成
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/users.db
PORT=3000
# 如果和前端不同，单独配：
# OPENCLAW_WS_URL=ws://龙虾IP:18789
# OPENCLAW_TOKEN=
